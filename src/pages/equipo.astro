---
import PlainLayout from '@/layouts/PlainLayout.astro';
import { miembrosEquipo } from '@/data/equipo';
import { SITE_CONFIG } from '@/config/site';

const title = 'Equipo - Fierro Fermat';
const description = 'Conoce al equipo de Fierro Fermat, profesionales comprometidos con hacer la justicia accesible.';
---

<PlainLayout title={title} description={description} fullWidth={true}>
  <div class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <header class="mb-12 text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">
        Nuestro Equipo
      </h1>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto">
        Conoce a las personas detrás de Fierro Fermat
      </p>
    </header>

    <div class="max-w-5xl mx-auto space-y-16 mb-12">
      {miembrosEquipo.map((miembro) => (
        <article id={miembro.slug} class="scroll-mt-24 flow-root">
          <div class="w-full max-w-xs mx-auto mb-6 md:float-left md:w-72 md:mr-8 md:mb-4">
            <div class="w-full aspect-square">
              <img
                src={miembro.foto}
                alt={miembro.name}
                class="w-full h-full object-cover rounded-lg shadow-lg"
                loading="eager"
              />
            </div>
          </div>

          <header class="text-center md:text-left mb-6">
            <span class="inline-block bg-gray-100 text-gray-600 text-xs font-semibold px-3 py-1 rounded mb-3">
              COLOMBIA
            </span>
            <h2 class="text-3xl md:text-4xl font-bold text-primary-700 mb-2">
              {miembro.name}
            </h2>
            <p class="text-xl text-gray-600">
              {miembro.cargo}
            </p>
            <span class="inline-block w-16 h-1 bg-primary-700 rounded mt-5" aria-hidden="true"></span>
          </header>

          <div class="space-y-4 text-gray-700 text-lg leading-relaxed text-justify hyphens-auto" lang="es">
            <p>{miembro.experienciaAcademica}</p>
            <p>{miembro.experienciaProfesional}</p>
          </div>
        </article>
      ))}
    </div>

    <section class="bg-beige-100 rounded-lg p-8 text-center mt-12 border border-beige-300">
      <h2 class="text-2xl font-bold text-charcoal-700 mb-4">
        ¿Quieres formar parte del equipo?
      </h2>
      <p class="text-lg text-charcoal-600 mb-6">
        Estamos siempre buscando personas comprometidas con hacer la justicia accesible
      </p>
      <a href={SITE_CONFIG.whatsappUrlConsulta} target="_blank" rel="noopener noreferrer" class="btn-primary">
        Contáctanos
      </a>
    </section>
  </div>
</PlainLayout>

<style>
  .aspect-square {
    aspect-ratio: 1 / 1;
  }
</style>
