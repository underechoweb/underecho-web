---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Hero from "@/components/Hero.astro";
import SectionWrap from "@/components/SectionWrap.astro";
import CTA from "@/components/CTA.astro";
import { SITE_CONFIG } from "@/config/site";
const whatsappConsulta = SITE_CONFIG.whatsappUrlConsulta;
import ctaImage from "@/assets/cta.webp";

const ctaItems = [
  {
    title: "Consultas virtuales, ágiles y seguras",
    description: "Atención inmediata y experta desde cualquier parte del país. Soluciones estratégicas y 100% online.",
    icon: "clock",
  },
  {
    title: "Acompañamiento humano y honesto",
    description: "En UD no hay promesas imposibles. Te decimos la verdad y te explicamos tus opciones con claridad y responsabilidad. Tu caso no es una estadística, es nuestro compromiso.",
    icon: "people",
  },
  {
    title: "Excelencia y experiencia multidisciplinaria",
    description: "Se designará a un abogado experto en el área de tu emergencia.",
    icon: "expertise",
  },
  {
    title: "Tarifas accesibles",
    description: "No habrá costos ocultos ni excesivos, solo tarifas accesibles que se adecuan a ti.",
    icon: "balance",
  },
];
---

<BaseLayout title={SITE_CONFIG.title} description={SITE_CONFIG.description}>
  <Hero
    title="Justicia y seguridad a su alcance"
    subtitle="Comprometidos con su tranquilidad y confianza."
    ctaText="Agende su consulta"
    ctaHref={whatsappConsulta}
  />

  <section id="mensaje-principal" class="relative overflow-hidden">
    <div class="flex flex-col lg:flex-row min-h-[500px] lg:min-h-[600px]">
      <div class="relative lg:w-[55%] min-h-[320px] lg:min-h-0">
        <img
          src={ctaImage.src}
          alt="Profesional de Un Derecho en oficina"
          class="absolute inset-0 w-full h-full object-cover object-center"
          loading="eager"
        />
        <div class="absolute bottom-6 left-1/2 -translate-x-1/2 md:bottom-8 z-10 w-[calc(100%-2rem)] max-w-[280px] sm:max-w-none sm:w-auto">
          <a href={whatsappConsulta} target="_blank" rel="noopener noreferrer" class="btn-primary !text-white inline-block w-full sm:w-auto text-center text-sm sm:text-base md:text-lg px-4 py-3 sm:px-6 sm:py-4 md:px-8 md:py-4 whitespace-normal">
            Agende su consulta
          </a>
        </div>
      </div>

      <div class="lg:w-[45%] bg-cream-100/95 backdrop-blur-sm border-l border-beige-300 flex flex-col justify-center px-6 py-10 md:px-8 lg:px-10 lg:py-12">
        <ul class="space-y-6 md:space-y-8">
          {ctaItems.map((item, i) => (
            <li class="flex flex-col items-center gap-4 md:flex-row md:items-start md:gap-4">
              <div class="flex-shrink-0 w-12 h-12 flex items-center justify-center text-primary-500" aria-hidden="true">
                {item.icon === "clock" && (
                  <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                )}
                {item.icon === "people" && (
                  <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                  </svg>
                )}
                {item.icon === "expertise" && (
                  <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                )}
                {item.icon === "balance" && (
                  <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3" />
                  </svg>
                )}
              </div>
              <div class="text-center md:text-left w-full md:w-auto min-w-0">
                <h3 class="font-bold text-charcoal-700 font-serif text-base md:text-lg mb-1">{item.title}</h3>
                <p class="text-charcoal-600 text-sm md:text-base leading-relaxed">{item.description}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <SectionWrap id="servicios" backgroundColor="gray" padding="xl">
    <div class="text-center mb-12">
      <h2
        class="text-3xl md:text-4xl font-bold text-charcoal-700 mb-6 font-serif"
      >
        Servicios Jurídicos
      </h2>
      <p
        class="text-lg md:text-xl text-charcoal-500 max-w-3xl mx-auto leading-relaxed"
      >
        Asesorías legales especializadas con soluciones a la medida. Nuestro
        equipo cuenta con experiencia en diversas industrias y áreas del derecho
        para ayudarte a tomar decisiones jurídicas claras y bien fundamentadas.
      </p>
    </div>

    <div class="text-center mt-12">
      <a
        href="/servicios"
        class="btn-primary text-sm md:text-lg px-4 md:px-8 py-3 md:py-4 whitespace-normal break-words"
      >
        Ver todos los servicios
      </a>
    </div>
  </SectionWrap>

  <SectionWrap id="nosotros" backgroundColor="gray" padding="xl" class="hidden">
    <div
      class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center max-w-7xl mx-auto"
    >
      <div class="text-center md:text-left">
        <h2
          class="text-3xl md:text-4xl font-bold text-primary-500 mb-6 font-serif"
        >
          Nosotros
        </h2>
        <p class="text-lg text-charcoal-500 mb-4 leading-relaxed">
          Un Derecho es una firma de abogados conformada por un equipo de
          profesionales con sólida formación y experiencia, orientados al
          ejercicio responsable y estratégico del derecho.
        </p>
        <p class="text-lg text-charcoal-500 mb-6 leading-relaxed">
          Nuestro trabajo se fundamenta en el rigor técnico, la ética
          profesional y un enfoque práctico que prioriza soluciones bien
          pensadas y jurídicamente consistentes, siempre con un trato cercano y
          respetuoso hacia quienes confían en nosotros.
        </p>
        <div class="flex justify-center md:justify-start">
          <a href="/nosotros" class="btn-secondary">
            Conoce más sobre nosotros
          </a>
        </div>
      </div>
      <div class="relative">
        <div
          class="absolute -inset-1 bg-gradient-to-r from-gold-400 to-gold-600 rounded-lg blur opacity-20"
        >
        </div>
        <img
          src="https://images.unsplash.com/photo-1589829545856-d10d557cf95f?w=800&h=600&fit=crop"
          alt="Equipo de UnDerecho"
          class="relative rounded-lg shadow-xl w-full"
          loading="lazy"
        />
      </div>
    </div>
  </SectionWrap>

  <div
    class="w-full h-px bg-gradient-to-r from-transparent via-gold-400 to-transparent opacity-40"
  >
  </div>

  <div class="hidden">
  <CTA
    title="Justicia honesta, cercana y a su alcance"
    description="Acompañamiento humano, claro y comprometido desde el primer contacto. Su tranquilidad es nuestra prioridad."
    primaryText="Agende su consulta"
    primaryHref={whatsappConsulta}
    benefits={[
      "Consultas 100% Virtuales",
      "Tarifas Justas",
      "Acceso Nacional Inmediato",
    ]}
    closingText="Da el primer paso hacia una solución clara y justa. Tu problema importa."
  />
  </div>
</BaseLayout>
