---
import PlainLayout from "@/layouts/PlainLayout.astro";
import Card from "@/components/Card.astro";
import { areasPractica } from "@/data/servicios";
import { SITE_CONFIG } from "@/config/site";

const title = "Servicios - UnDerecho";
const description =
  "Nuestro equipo cuenta con experiencia en diversas industrias y áreas del derecho, lo que nos permite comprender las necesidades de cada cliente y ofrecer asesorías legales especializadas con soluciones a la medida.";
---

<PlainLayout title={title} description={description} fullWidth={true}>
  <div class="w-full bg-beige-100 min-h-screen">
    <div class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
      <header class="mb-12 text-center">
        <h1
          class="text-4xl md:text-5xl font-bold text-charcoal-700 mb-6 font-serif"
        >
          Servicios Jurídicos
        </h1>
        <div class="w-24 h-1 bg-gold-500 mx-auto mb-6"></div>
        <p class="text-xl text-charcoal-600 max-w-4xl mx-auto leading-relaxed">
          Nuestro equipo cuenta con experiencia en diversas industrias y áreas
          del derecho, lo que nos permite comprender las necesidades de cada
          cliente y ofrecer asesorías legales especializadas con soluciones a la
          medida. Conoce nuestros servicios y contáctanos para saber cómo
          podemos ayudarte a tomar decisiones jurídicas claras y bien
          fundamentadas.
        </p>
      </header>

      <div
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8 mb-12"
      >
        {
          areasPractica.map((area) => (
            <Card
              title={area.title}
              description={area.description}
              image={area.image}
              imageAlt={area.title}
              href={`/servicios/${area.slug}`}
              variant="service"
            />
          ))
        }
      </div>

      <section
        class="bg-beige-100 rounded-lg p-8 md:p-12 text-center mt-12 border border-beige-300"
      >
        <h2
          class="text-2xl md:text-3xl font-bold text-charcoal-700 mb-4 font-serif"
        >
          ¿Necesitas ayuda con algún servicio?
        </h2>
        <p class="text-lg md:text-xl text-charcoal-600 mb-6">
          Contáctanos y recibe una primera orientación gratuita
        </p>
        <a href={SITE_CONFIG.whatsappUrlConsulta} target="_blank" rel="noopener noreferrer" class="btn-primary"> Contáctanos ahora </a>
      </section>
    </div>
  </div>
</PlainLayout>
