---
import PlainLayout from "@/layouts/PlainLayout.astro";
import { SITE_CONFIG } from "@/config/site";
import { miembrosEquipo, miembrosEquipoMap } from "@/data/equipo";

export async function getStaticPaths() {
  return miembrosEquipo.map((miembro) => ({
    params: { slug: miembro.slug },
  }));
}

const { slug } = Astro.params;
const miembro = slug ? miembrosEquipoMap[slug] : null;

if (!miembro) {
  return Astro.redirect("/equipo");
}

const pageTitle = `${miembro.name} - Equipo - ${SITE_CONFIG.name}`;
const pageDescription = `${miembro.cargo} - ${miembro.area}`;
---

<PlainLayout title={pageTitle} description={pageDescription} fullWidth={true}>
  <div class="w-full max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <a
      href="/equipo"
      class="inline-flex items-center text-primary-700 hover:text-primary-800 font-semibold mb-8 transition-colors focus:outline-none focus:ring-2 focus:ring-primary-600 rounded"
    >
      <svg
        class="w-5 h-5 mr-2"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M15 19l-7-7 7-7"></path>
      </svg>
      Volver al Equipo
    </a>

    <article>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
        <div class="md:col-span-1">
          <div class="w-full aspect-square mb-4">
            <img
              src={miembro.foto}
              alt={miembro.name}
              class="w-full h-full object-cover rounded-lg shadow-lg"
              loading="eager"
            />
          </div>

          <div class="text-center md:text-left">
            <span
              class="inline-block bg-gray-100 text-gray-600 text-xs font-semibold px-3 py-1 rounded"
            >
              COLOMBIA
            </span>
          </div>
        </div>

        <div class="md:col-span-2">
          <header class="mb-6">
            <h1 class="text-3xl md:text-4xl font-bold text-primary-700 mb-3">
              {miembro.name}
            </h1>
            <p class="text-xl text-gray-600 mb-2">
              {miembro.cargo}
            </p>
            <p class="text-gray-500 mb-6">
              {miembro.area}
            </p>
          </header>

          <div class="space-y-3 mb-8">
            <div class="flex items-center text-gray-700">
              <svg
                class="w-5 h-5 mr-3 text-primary-700"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                ></path>
              </svg>
              <a
                href={`tel:${miembro.telefono.replace(/\s/g, "")}`}
                class="hover:text-primary-700 transition-colors"
              >
                {miembro.telefono}
              </a>
            </div>
            <div class="flex items-center text-gray-700">
              <svg
                class="w-5 h-5 mr-3 text-primary-700"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                ></path>
              </svg>
              <a
                href={`mailto:${miembro.email}`}
                class="hover:text-primary-700 transition-colors break-all"
              >
                {miembro.email}
              </a>
            </div>
          </div>
        </div>
      </div>

      <section class="mb-8">
        <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-4">
          Experiencia Académica
        </h2>
        <div class="prose prose-lg max-w-none">
          <p class="text-gray-700 leading-relaxed">
            {miembro.experienciaAcademica}
          </p>
        </div>
      </section>

      <section class="mb-8">
        <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-4">
          Experiencia Profesional
        </h2>
        <div class="prose prose-lg max-w-none">
          <p class="text-gray-700 leading-relaxed">
            {miembro.experienciaProfesional}
          </p>
        </div>
      </section>

      <section
        class="mt-12 bg-beige-100 rounded-lg p-8 text-center border border-beige-300"
      >
        <h2 class="text-2xl font-bold text-charcoal-700 mb-4">
          ¿Necesitas contactar a {miembro.name.split(" ")[0]}?
        </h2>
        <p class="text-lg text-charcoal-600 mb-6">
          Escríbenos y te ponemos en contacto
        </p>
        <a href={SITE_CONFIG.whatsappUrlConsulta} target="_blank" rel="noopener noreferrer" class="btn-primary"> Contáctanos </a>
      </section>
    </article>
  </div>
</PlainLayout>

<style>
  .aspect-square {
    aspect-ratio: 1 / 1;
  }
</style>
