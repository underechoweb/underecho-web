---
import PlainLayout from "@/layouts/PlainLayout.astro";
import { SITE_CONFIG } from "@/config/site";
import { areasPractica, areasDataMap } from "@/data/servicios";

export async function getStaticPaths() {
  return areasPractica.map((area) => ({
    params: { slug: area.slug },
  }));
}

const { slug } = Astro.params;
const area = slug ? areasDataMap[slug] : null;

if (!area) {
  return Astro.redirect("/servicios");
}

const pageTitle = `${area.title} - Servicios - ${SITE_CONFIG.name}`;
const pageDescription = area.description;
---

<PlainLayout title={pageTitle} description={pageDescription} fullWidth={true}>
  <div class="w-full max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <a
      href="/servicios"
      class="inline-flex items-center text-primary-700 hover:text-primary-800 font-semibold mb-8 transition-colors focus:outline-none focus:ring-2 focus:ring-primary-600 rounded"
    >
      <svg
        class="w-5 h-5 mr-2"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M15 19l-7-7 7-7"></path>
      </svg>
      Volver a Áreas de Práctica
    </a>

    <article>
      <header class="mb-8">
        <h1 class="text-4xl md:text-5xl font-bold text-primary-700 mb-6">
          {area.title}
        </h1>
        <p class="text-xl text-gray-700 leading-relaxed">
          {area.description}
        </p>
      </header>

      <section class="mt-12">
        <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-6">
          Portafolio de servicios:
        </h2>
        <ul class="space-y-3">
          {
            area.portafolio.map((servicio) => (
              <li class="flex items-start">
                <span class="text-primary-700 mr-3 font-bold mt-1">•</span>
                <span class="text-gray-700 text-lg">{servicio}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <section
        class="mt-12 bg-beige-100 rounded-lg p-8 text-center border border-beige-300"
      >
        <h2 class="text-2xl font-bold text-charcoal-700 mb-4">
          ¿Necesitas asesoría en {area.title.toLowerCase()}?
        </h2>
        <p class="text-lg text-charcoal-600 mb-6">
          Contáctanos y recibe una primera orientación gratuita
        </p>
        <a href={SITE_CONFIG.whatsappUrlConsulta} target="_blank" rel="noopener noreferrer" class="btn-primary"> Contáctanos ahora </a>
      </section>
    </article>
  </div>
</PlainLayout>
