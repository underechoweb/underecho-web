---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Artículo - UnDerecho"
  description="Artículos y guías legales."
>
  <div id="articulos-ver-root" class="min-h-screen bg-beige-100 py-12">
    <p class="container mx-auto px-4 text-charcoal-500">Cargando…</p>
  </div>
</BaseLayout>

<script>
  import { supabaseApi } from "@/services/supabaseApi.service";

  function escapeHtml(s: string): string {
    const div = document.createElement("div");
    div.textContent = s;
    return div.innerHTML;
  }

  function formatDate(ts: string): string {
    try {
      return new Date(ts).toLocaleDateString("es-CO", {
        year: "numeric",
        month: "long",
        day: "numeric",
      });
    } catch {
      return ts;
    }
  }

  async function load() {
    const root = document.getElementById("articulos-ver-root");
    if (!root) return;

    const params = new URLSearchParams(window.location.search);
    const pk = parseInt(params.get("pk") ?? "", 10);
    if (!Number.isFinite(pk)) {
      root.innerHTML =
        '<div class="container mx-auto px-4 max-w-4xl"><p class="text-charcoal-500">Parámetros no válidos.</p><a href="/articulos" class="text-primary-600 hover:underline">Volver a artículos</a></div>';
      return;
    }

    try {
      const row = await supabaseApi.getArticleByPk(pk);
      if (!row) {
        root.innerHTML =
          '<div class="container mx-auto px-4 max-w-4xl"><p class="text-charcoal-500">No encontrado.</p><a href="/articulos" class="text-primary-600 hover:underline">Volver a artículos</a></div>';
        return;
      }

      const tags = ["Artículos", "Guías", "Derecho"];
      const dateStr = formatDate(row.created_at);
      const imageHtml = row.image
        ? `<div class="mb-8 rounded-lg overflow-hidden"><img src="${escapeHtml(row.image)}" alt="${escapeHtml(row.title)}" class="w-full h-auto max-h-96 object-cover" loading="eager" /></div>`
        : "";
      root.innerHTML = `
        <article class="container mx-auto px-4 py-12 max-w-4xl">
          ${imageHtml}
          <div class="mb-8">
            <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4 break-words">${escapeHtml(row.title)}</h1>
            <div class="flex flex-wrap gap-4 text-gray-600 text-sm mb-4">
              <time datetime="${escapeHtml(row.created_at)}">${dateStr}</time>
              <span>Por ${escapeHtml(row.author || "Equipo UnDerecho")}</span>
            </div>
            <div class="flex flex-wrap gap-2">
              ${tags.map((t) => `<span class="bg-primary-100 text-primary-700 text-sm px-3 py-1 rounded-full">${escapeHtml(t)}</span>`).join("")}
            </div>
          </div>
          <div class="prose prose-lg max-w-none prose-headings:text-gray-900 prose-p:text-gray-700 prose-a:text-primary-700 prose-a:no-underline hover:prose-a:underline prose-strong:text-gray-900 prose-ul:text-gray-700 prose-ol:text-gray-700 prose-li:text-gray-700" id="articulos-ver-content"></div>
          <div class="mt-12 pt-8 border-t border-gray-200">
            <a href="/articulos" class="inline-block text-primary-700 font-semibold hover:text-primary-800">← Volver a artículos</a>
          </div>
        </article>
      `;
      const contentEl = document.getElementById("articulos-ver-content");
      if (contentEl) contentEl.innerHTML = row.content ?? "";
    } catch (e) {
      root.innerHTML = `<div class="container mx-auto px-4 max-w-4xl"><p class="text-red-600">${escapeHtml(e instanceof Error ? e.message : "Error")}</p><a href="/articulos" class="text-primary-600 hover:underline">Volver a artículos</a></div>`;
    }
  }

  document.addEventListener("astro:page-load", load);
  if (document.readyState === "loading")
    document.addEventListener("DOMContentLoaded", load);
  else load();
</script>
