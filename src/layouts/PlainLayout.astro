---
import BaseLayout from './BaseLayout.astro';
import type { PlainLayoutProps } from '@/types';

interface Props extends PlainLayoutProps {}

const { title, description, fullWidth = false } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <div class={`container mx-auto px-4 py-12 ${fullWidth ? '' : 'max-w-4xl'}`}>
    <slot />
  </div>
</BaseLayout>
