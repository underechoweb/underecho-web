---
import BaseLayout from './BaseLayout.astro';
import type { EditorialLayoutProps } from '@/types';

interface Props extends EditorialLayoutProps {}

const { title, description, publishDate, author, image } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <article class="container mx-auto px-4 py-12 max-w-4xl">
    {image && (
      <div class="mb-8">
        <img 
          src={image} 
          alt={title || ''} 
          class="w-full h-auto rounded-lg shadow-lg"
          loading="lazy"
        />
      </div>
    )}
    
    <header class="mb-8">
      <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">
        {title}
      </h1>
      
      {(publishDate || author) && (
        <div class="flex flex-wrap gap-4 text-gray-600 text-sm">
          {publishDate && (
            <time datetime={publishDate.toISOString()}>
              {publishDate.toLocaleDateString('es-CO', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })}
            </time>
          )}
          {author && (
            <span>Por {author}</span>
          )}
        </div>
      )}
    </header>
    
    <div class="prose prose-lg max-w-none prose-headings:text-gray-900 prose-p:text-gray-700 prose-a:text-primary-700 prose-a:no-underline hover:prose-a:underline prose-strong:text-gray-900 prose-ul:text-gray-700 prose-ol:text-gray-700 prose-li:text-gray-700">
      <slot />
    </div>
  </article>
</BaseLayout>
