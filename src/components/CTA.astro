---
import type { CTAProps } from "@/types";

interface Props extends CTAProps {}

const {
  title,
  description,
  primaryText = "Agende su consulta",
  primaryHref = "/contacto",
  benefits = [
    "Consultas 100% Virtuales",
    "Tarifas Justas",
    "Acceso Nacional Inmediato",
  ],
  closingText = "Da el primer paso hacia una solución clara y justa. Tu problema importa.",
} = Astro.props;
---

<section
  class="relative py-16 md:py-20 lg:py-24 bg-beige-50"
  aria-labelledby="cta-title"
>
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto text-center">
      <h2
        id="cta-title"
        class="text-3xl md:text-4xl lg:text-5xl font-bold text-charcoal-700 mb-6 font-serif"
      >
        {title}
      </h2>

      <div class="w-24 h-1 bg-gold-500 mx-auto mb-8"></div>

      {
        description && (
          <p class="text-lg md:text-xl text-charcoal-600 mb-10 max-w-3xl mx-auto leading-relaxed">
            {description}
          </p>
        )
      }

      {
        benefits && benefits.length > 0 && (
          <div class="mb-10">
            <ul class="flex flex-col md:flex-row flex-wrap items-center justify-center gap-4 md:gap-6">
              {benefits.map((benefit) => (
                <li class="flex items-center gap-2 text-charcoal-600 text-base md:text-lg">
                  <span class="w-2 h-2 bg-gold-500 rounded-full flex-shrink-0" />
                  <span>{benefit}</span>
                </li>
              ))}
            </ul>
          </div>
        )
      }

      <div class="mb-10">
        <a
          href={primaryHref}
          class="btn-primary inline-block"
          {...(primaryHref.startsWith("http") ? { target: "_blank", rel: "noopener noreferrer" } : {})}
        >
          {primaryText}
        </a>
      </div>

      {
        closingText && (
          <p class="text-lg md:text-xl text-charcoal-700 max-w-2xl mx-auto leading-relaxed font-medium italic">
            {closingText}
          </p>
        )
      }
    </div>
  </div>
</section>
