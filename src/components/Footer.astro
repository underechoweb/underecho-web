---
import { SITE_CONFIG } from "@/config/site";
import logo_original from "@/assets/sin_fondo/logo_original.webp";

const currentYear = new Date().getFullYear();
const email = "underecho.abog@gmail.com";
const whatsappNumber = "573180699745";
const whatsappDisplay = "+57 318 0699745";
const whatsappUrl = `https://wa.me/${whatsappNumber}`;
const legalLinks = [
  { label: "Términos y condiciones", href: "/terminos-y-condiciones" },
  { label: "Política de tratamiento de datos", href: "/politica-tratamiento-datos" },
  { label: "Seguridad de la información", href: "/seguridad-informacion" },
];

const socialLinks = [
  { name: "Instagram", href: "https://www.instagram.com/un.derecho/", icon: "instagram" },
  { name: "Facebook", href: "https://web.facebook.com/people/Un-Derecho/61577519450590/?rdid=3ccSvViQpP2FPJVI&share_url=https%3A%2F%2Fweb.facebook.com%2Fshare%2F17tYEuzaMk%2F%3F_rdc%3D1%26_rdr", icon: "facebook" },
  { name: "TikTok", href: "https://www.tiktok.com/@un.derecho?_r=1&_t=ZS-93PG0UFQ6ps", icon: "tiktok" },
  { name: "LinkedIn", href: "https://www.linkedin.com/company/un-derecho/", icon: "linkedin" },
  { name: "YouTube", href: SITE_CONFIG.youtubeUrl, icon: "youtube" },
];

const serviciosFooter = [
  { label: "Consultoría jurídica inmediata", href: "/servicios" },
  { label: "Áreas de práctica", href: "/servicios" },
];
---

<footer class="bg-charcoal-800 text-white mt-auto" role="contentinfo">
  <div class="bg-charcoal-900 border-b border-charcoal-700">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div
        class="flex flex-col md:flex-row md:justify-between md:items-center gap-4 md:gap-6 py-4"
      >
        <!-- WhatsApp -->
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 text-sm md:text-base hover:text-gold-400 transition-colors focus:outline-none focus:ring-2 focus:ring-gold-500 rounded"
          aria-label="Escríbenos por WhatsApp"
        >
          <svg
            class="w-5 h-5 flex-shrink-0"
            fill="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"
            ></path>
          </svg>
          <span class="text-gold-400 font-medium">Escríbenos por Whatsapp</span>
          <span class="text-white">{whatsappDisplay}</span>
        </a>

        <!-- Email -->
        <a
          href={`mailto:${email}`}
          class="flex items-center gap-2 text-sm md:text-base hover:text-gold-400 transition-colors focus:outline-none focus:ring-2 focus:ring-gold-500 rounded"
          aria-label="Envíanos un correo"
        >
          <svg
            class="w-5 h-5 flex-shrink-0"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
            ></path>
          </svg>
          <span class="text-gold-400 font-medium">Envíanos un correo</span>
          <span class="text-white break-all">{email}</span>
        </a>

        <!-- Razón social -->
        <div class="flex items-center gap-2 text-sm md:text-base group cursor-default hover:text-gold-400 transition-colors">
          <svg
            class="w-5 h-5 flex-shrink-0"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
            ></path>
          </svg>
          <span class="text-white group-hover:text-gold-400">Un Derecho SAS - NIT 901980569 0</span>
        </div>
      </div>
    </div>
  </div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12">
    <div class="flex flex-col lg:flex-row gap-4 lg:gap-12">
      <div
        class="flex flex-col items-center justify-center lg:flex-shrink-0 lg:w-1/3"
      >
        <a
          href="/"
          class="mb-4 lg:mb-6"
          aria-label={`${SITE_CONFIG.name} - Ir al inicio`}
        >
          <img
            src={logo_original.src}
            alt={SITE_CONFIG.name}
            class="h-20 md:h-28 lg:h-32 w-auto max-w-[260px] md:max-w-[320px] lg:max-w-[380px]"
            width={logo_original.width}
            height={logo_original.height}
          />
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 flex-1 w-full">
        <!-- Columna 1: Legal -->
        <div class="flex flex-col items-center md:items-start w-full min-w-0">
          <h3 class="text-gold-400 font-semibold mb-4 text-lg uppercase tracking-wide">
            Legal
          </h3>
          <ul class="space-y-2 w-full">
            {legalLinks.map((link) => (
              <li class="flex justify-center md:justify-start">
                <a
                  href={link.href}
                  class="text-white hover:text-gold-400 transition-colors focus:outline-none focus:ring-2 focus:ring-gold-500 rounded flex items-center gap-2"
                >
                  <span class="w-1.5 h-1.5 bg-gold-400 rounded-full flex-shrink-0"></span>
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- Columna 2: Redes -->
        <div class="flex flex-col items-center md:items-start w-full min-w-0">
          <h3 class="text-gold-400 font-semibold mb-4 text-lg uppercase tracking-wide">
            Redes
          </h3>
          <ul class="space-y-2 w-full">
            {socialLinks.map((social) => (
              <li class="flex justify-center md:justify-start">
                <a
                  href={social.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-white hover:text-gold-400 transition-colors focus:outline-none focus:ring-2 focus:ring-gold-500 rounded flex items-center gap-2"
                  aria-label={`Síguenos en ${social.name}`}
                >
                  <span class="w-1.5 h-1.5 bg-gold-400 rounded-full flex-shrink-0"></span>
                  {social.name}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- Columna 3: Nuestros Servicios -->
        <div class="flex flex-col items-center md:items-start w-full min-w-0">
          <h3 class="text-gold-400 font-semibold mb-4 text-lg uppercase tracking-wide">
            Nuestros Servicios
          </h3>
          <ul class="space-y-2 w-full">
            {serviciosFooter.map((s) => (
              <li class="flex justify-center md:justify-start">
                <a
                  href={s.href}
                  class="text-white hover:text-gold-400 transition-colors focus:outline-none focus:ring-2 focus:ring-gold-500 rounded flex items-center gap-2"
                >
                  <span class="w-1.5 h-1.5 bg-gold-400 rounded-full flex-shrink-0"></span>
                  {s.label}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- Columna 4: Sobre la Firma -->
        <div class="flex flex-col items-center md:items-start w-full min-w-0">
          <h3 class="text-gold-400 font-semibold mb-4 text-lg uppercase tracking-wide">
            Sobre la Firma
          </h3>
          <ul class="space-y-2 w-full">
            <li class="flex justify-center md:justify-start">
              <a
                href="/noticias"
                class="text-white hover:text-gold-400 transition-colors focus:outline-none focus:ring-2 focus:ring-gold-500 rounded flex items-center gap-2"
              >
                <span class="w-1.5 h-1.5 bg-gold-400 rounded-full flex-shrink-0"></span>
                Noticias
              </a>
            </li>
            <li class="flex justify-center md:justify-start">
              <a
                href="/articulos"
                class="text-white hover:text-gold-400 transition-colors focus:outline-none focus:ring-2 focus:ring-gold-500 rounded flex items-center gap-2"
              >
                <span class="w-1.5 h-1.5 bg-gold-400 rounded-full flex-shrink-0"></span>
                Artículos
              </a>
            </li>
            <li class="flex justify-center md:justify-start">
              <a
                href="/contacto"
                class="text-white hover:text-gold-400 transition-colors focus:outline-none focus:ring-2 focus:ring-gold-500 rounded flex items-center gap-2"
              >
                <span class="w-1.5 h-1.5 bg-gold-400 rounded-full flex-shrink-0"></span>
                Contacto
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div
      class="border-t border-charcoal-700 mt-8 md:mt-12 pt-6 text-center text-sm text-charcoal-300"
    >
      <p>
        &copy; {currentYear}
        {SITE_CONFIG.name}. Todos los derechos reservados.
      </p>
    </div>
  </div>
</footer>
