---
import type { CardProps } from "@/types";

interface Props extends CardProps {}

const {
  title,
  description,
  image,
  imageAlt,
  href,
  date,
  author,
  tag,
  variant = "default",
} = Astro.props;
---

{
  href ? (
    <article class="bg-beige-50 rounded-lg shadow-md hover:shadow-xl transition-all duration-300 overflow-hidden h-full flex flex-col border border-beige-200 hover:border-gold-300">
      <a
        href={href}
        class="block h-full flex flex-col focus:outline-none focus:ring-2 focus:ring-gold-500 focus:ring-offset-2 rounded-lg"
      >
        {image && (
          <div class="w-full h-48 bg-beige-100 rounded-t-lg overflow-hidden">
            <img
              src={image}
              alt={imageAlt || title}
              class="w-full h-full object-cover transition-transform duration-300 hover:scale-105"
              loading="lazy"
            />
          </div>
        )}

        <div class="p-6 flex-grow flex flex-col">
          {tag && (
            <span class="inline-block bg-gold-100 text-gold-700 text-xs font-semibold px-3 py-1 rounded-full mb-3 self-start">
              {tag}
            </span>
          )}

          <h3 class="text-xl font-bold text-charcoal-700 mb-3 font-serif break-words">
            {title}
          </h3>

          {description && (
            <p class="text-charcoal-600 mb-4 line-clamp-3 flex-grow">
              {description}
            </p>
          )}

          {(date || author) && (
            <div class="flex flex-wrap gap-2 text-sm text-charcoal-400 mb-4">
              {date && (
                <time datetime={date.toISOString()}>
                  {date.toLocaleDateString("es-CO", {
                    year: "numeric",
                    month: "short",
                    day: "numeric",
                  })}
                </time>
              )}
              {author && <span>• {author}</span>}
            </div>
          )}

          <span class="inline-block text-gold-600 font-semibold hover:text-gold-700 transition-colors mt-auto">
            Leer más →
          </span>
        </div>
      </a>
    </article>
  ) : (
    <article class="bg-beige-50 rounded-lg shadow-md overflow-hidden h-full flex flex-col border border-beige-200">
      {image && (
        <div class="w-full h-48 bg-beige-100 rounded-t-lg overflow-hidden">
          <img
            src={image}
            alt={imageAlt || title}
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>
      )}

      <div class="p-6 flex-grow flex flex-col">
        {tag && (
          <span class="inline-block bg-gold-100 text-gold-700 text-xs font-semibold px-3 py-1 rounded-full mb-3 self-start">
            {tag}
          </span>
        )}

        <h3 class="text-xl font-bold text-charcoal-700 mb-3 font-serif break-words">
          {title}
        </h3>

        {description && (
          <p class="text-charcoal-600 mb-4 line-clamp-3 flex-grow">
            {description}
          </p>
        )}

        {(date || author) && (
          <div class="flex flex-wrap gap-2 text-sm text-charcoal-400 mb-4">
            {date && (
              <time datetime={date.toISOString()}>
                {date.toLocaleDateString("es-CO", {
                  year: "numeric",
                  month: "short",
                  day: "numeric",
                })}
              </time>
            )}
            {author && <span>• {author}</span>}
          </div>
        )}

        {href && (
          <a
            href={href}
            class="inline-block text-gold-600 font-semibold hover:text-gold-700 transition-colors focus:outline-none focus:ring-2 focus:ring-gold-500 rounded mt-auto"
            aria-label={`Leer más sobre ${title}`}
          >
            Leer más →
          </a>
        )}
      </div>
    </article>
  )
}
