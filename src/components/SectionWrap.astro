---
import type { SectionWrapProps } from "@/types";

interface Props extends SectionWrapProps {}

const {
  id,
  class: className = "",
  backgroundColor = "white",
  padding = "lg",
} = Astro.props;

const bgClasses = {
  white: "",
  gray: "bg-beige-100",
  primary: "bg-primary-50",
};

const paddingClasses = {
  sm: "py-8",
  md: "py-12",
  lg: "py-16",
  xl: "py-24",
};
---

<section
  id={id}
  class={`${bgClasses[backgroundColor]} ${paddingClasses[padding]} relative ${className}`}
>
  <div
    class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-gold-300 to-transparent opacity-30"
  >
  </div>
  <div class="container mx-auto px-4">
    <slot />
  </div>
</section>
